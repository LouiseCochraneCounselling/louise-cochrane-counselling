# Environment Variables for The Holding Space Website
# Copy this file to .env.local for local development
# For production, set these in Vercel Project Settings → Environment Variables

# Email Configuration
# The email address where form submissions will be sent
CONTACT_EMAIL=your-email@example.com

# Resend API Configuration
# Your Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: Sender email address (must be verified in Resend)
# If not set, defaults to hello@theholdingspace.co.uk
RESEND_FROM_EMAIL=hello@theholdingspace.co.uk
